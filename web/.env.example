#  WinCut - NEAR mainnet
#
#  Copy to .env.local and fill in NEXT_PUBLIC_CONTRACT_ID after deploying.
#  Every other value below was read off mainnet by RPC view call; re-check any
#  time with `node scripts/verify-mainnet.mjs` from the repo root.

NEXT_PUBLIC_NETWORK=mainnet

# The WinCut settlement contract. Deploy it to a sub-account of your own
# account - `node scripts/print-deploy-commands.mjs wincut.you.near you.near`
# prints every command. Until this is set the app says so instead of guessing.
NEXT_PUBLIC_CONTRACT_ID=

# Read endpoint. FastNEAR's free tier is the default; the app falls back to the
# public RPC and then to Lava on its own, so one endpoint refusing does not
# take a screen down. A paid FastNEAR/Lava key goes here for the demo.
NEXT_PUBLIC_RPC_URL=https://free.rpc.fastnear.com

# Rhea Finance (formerly Ref Finance) classic AMM. Verified at v1.9.21.
NEXT_PUBLIC_REF_CONTRACT=v2.ref-finance.near

# Native Circle USDC on NEAR, 6 decimals.
NEXT_PUBLIC_USDC_ID=17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1

# Tradable tokens, in display order. Each one needs a matching `list_token` on
# the contract - the app reads the routes and decimals from the contract, not
# from here, so this list only controls what is offered and in what order.
#
#   wrap.near                        wNEAR       pool #4512
#   token.rhealab.near               RHEA        #4512 -> #6458
#   token.burrow.near                BRRR        #4512 -> #3474   (thin, ~$4k)
#   blackdragon.tkn.near             BLACKDRAGON #4512 -> #4276
#   token.0xshitzu.near              SHITZU      #4512 -> #4369
#   token.lonkingnearbackto2024.near LONK        #4512 -> #4314
NEXT_PUBLIC_TOKENS=wrap.near,token.rhealab.near,token.burrow.near,blackdragon.tkn.near,token.0xshitzu.near,token.lonkingnearbackto2024.near

# Optional. NEAR Intents 1Click works unauthenticated, which is how the demo
# runs; a key raises the rate limit. Server-side only - never NEXT_PUBLIC_,
# because the browser must not hold it.
# ONECLICK_API_KEY=


# ---------------------------------------------------------------------------
#  Testnet
# ---------------------------------------------------------------------------
#
#  To point the app at testnet instead, swap the six values above for these.
#  Every id was verified on chain - see near-contract/addresses.testnet.json
#  and re-check any time with `node scripts/verify-testnet.mjs`.
#
#   NEXT_PUBLIC_NETWORK=testnet
#   NEXT_PUBLIC_CONTRACT_ID=wincut-mansi.testnet
#   NEXT_PUBLIC_RPC_URL=https://test.rpc.fastnear.com
#   NEXT_PUBLIC_REF_CONTRACT=ref-finance-101.testnet
#   NEXT_PUBLIC_USDC_ID=thusdc.testnet
#   NEXT_PUBLIC_TOKENS=wrap.testnet,lnc.factory.tokenhub.testnet,token.pembrock.testnet,phoenix-bonds.testnet,mev-33.factory.v9.meme-cooking.testnet,shit1.gf-bignumbers.testnet


# ---------------------------------------------------------------------------
#  The testnet price series  (testnet only - mainnet ignores all of this)
# ---------------------------------------------------------------------------
#
#  GeckoTerminal indexes NEAR mainnet only. On testnet there is no chart unless
#  WinCut indexes the pools itself, so it does: /api/sample reads the pool
#  reserves on a schedule and stores the price, /api/candles folds those points
#  into OHLC, and /api/backfill tries to recover historical swaps.
#
#  Without these the app still runs - the chart says it is not collecting yet
#  rather than drawing anything invented.

# Upstash Redis, REST flavour. Create a database at console.upstash.com and
# copy both values from its REST API panel. Server-side only.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Shared secret guarding /api/sample and /api/backfill, which both write.
# Any long random string; generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# The cron sends it as the `x-cron-secret` header. See docs/DEPLOY.md.
CRON_SECRET=


# ---------------------------------------------------------------------------
#  The autonomous agent  (optional)
# ---------------------------------------------------------------------------
#
#  The account id of the WinCut Agent, once it is running. Setting it makes the
#  app mark that trader as an AI agent on the leaderboard and on its own page,
#  and show its decision log - read from the same Upstash database the agent
#  writes to, above.
#
#  Leave it empty and nothing about the agent appears anywhere. See agent/README.md.

NEXT_PUBLIC_AGENT_ACCOUNT_ID=


# ---------------------------------------------------------------------------
#  The WinCut-operated testnet market  (optional, testnet only)
# ---------------------------------------------------------------------------
#
#  Testnet has no traders, so WinCut can run its own market: its own token, its
#  own pool, a market maker pegging it to real mainnet NEAR, and three trader
#  bots. Every candle is then a real on-chain swap - see bots/README.md.
#
#  These turn the DISCLOSURE on. Set them in the same deploy that first shows
#  the market: a WinCut-operated market shown without its badge is the one
#  genuinely dishonest state this setup can reach.

# Shows the "WinCut-operated market" card on that token's trade screen.
NEXT_PUBLIC_MIRROR_TOKEN_ID=

# Marked "Market maker" and explained as not being a trader.
NEXT_PUBLIC_MM_ACCOUNT=

# Comma-separated. Each gets a "Bot" badge on the leaderboard and its page.
NEXT_PUBLIC_BOT_ACCOUNTS=

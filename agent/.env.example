#  WinCut Agent
#
#  Copy to .env and fill in. .env is gitignored; never commit a key.
#  Without AGENT_PRIVATE_KEY the agent decides and logs but never signs, which
#  is a genuine rehearsal - it still reads the real chain.

# The function-call key from `near account add-key ... --function-names 'buy,sell'`.
# See README.md. This key cannot withdraw, claim, or transfer anything.
AGENT_PRIVATE_KEY=

# Defaults to agent.<contract> and wincut-mansi.testnet respectively.
AGENT_ACCOUNT_ID=
WINCUT_CONTRACT_ID=

NEAR_NETWORK=testnet
# NEAR_RPC_URL=https://test.rpc.fastnear.com

# NEAR AI Cloud, or any OpenAI-compatible endpoint. Without a key the
# deterministic momentum fallback decides, and the log records which one did.
NEAR_AI_API_KEY=
# NEAR_AI_MODEL=deepseek-v3
# NEAR_AI_BASE_URL=https://api.near.ai/v1

# The decision log. Use the same Upstash database as the web app so the
# /trader page reads what the agent writes.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Where testnet candles are read from.
# WINCUT_WEB_URL=https://wincut.vercel.app

# AGENT_LOOP_MS=300000
# DRY_RUN=1

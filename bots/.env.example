#  WinCut Bots
#
#  Copy to .env and fill in. .env is gitignored; never commit a key.
#  `npm run plan` prints every amount these commands need, from the live peg.

# From `add_simple_pool` in step 2. The bots refuse to start without it.
MIRROR_POOL_ID=

# The market maker's FULL-ACCESS key. It needs one, because ft_transfer_call
# requires a yoctoNEAR deposit and a function-call key cannot attach one.
# The account holds only gas and pool inventory.
MM_PRIVATE_KEY=

# The three traders' function-call keys: buy/sell on WinCut, nothing else.
BOT1_PRIVATE_KEY=
BOT2_PRIVATE_KEY=
BOT3_PRIVATE_KEY=

# Same Upstash database as the web app, so the prices land in the chart.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Defaults are in src/config.ts; uncomment only to override.
# MIRROR_TOKEN_ID=mnear.tkn.primitives.testnet
# MIRROR_SYMBOL=MNEAR
# MIRROR_DECIMALS=24
# WINCUT_CONTRACT_ID=wincut-mansi.testnet
# REF_CONTRACT=ref-finance-101.testnet
# USDC_ID=thusdc.testnet

# MM_ACCOUNT_ID=mm.wincut-mansi.testnet
# BOT1_ACCOUNT_ID=momo.wincut-mansi.testnet
# BOT2_ACCOUNT_ID=revert.wincut-mansi.testnet
# BOT3_ACCOUNT_ID=grid.wincut-mansi.testnet

# How far the pool may drift before the maker acts. Smaller = flatter chart.
# PEG_BAND_PCT=0.6
# PEG_MAX_TRADE_USDC=120

# DRY_RUN=1
